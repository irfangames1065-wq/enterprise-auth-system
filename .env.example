PORT=3001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-your-secure-jwt-secret

# MongoDB Atlas: use your real Atlas connection string in your local .env file only
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=<app-name>

# SMTP Settings: set these in your local .env or Render environment variables only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
FROM_EMAIL=your-gmail-address@gmail.com
TO_EMAIL=your-destination-email@example.com


